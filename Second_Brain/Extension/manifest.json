{
  "manifest_version": 3,
  "name": "Second Brain Extension",
  "version": "1.0",
  "description": "Save content directly to your Second Brain.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Second Brain"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*"
  ]
}
